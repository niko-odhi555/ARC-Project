    "# Taking a spatial average of EHF over the high eddy kinetic energy region\n",
    "region_eke = eke_subset.mean(axis=(1,2))\n",
    "print(region_eke.shape)\n",
    "\n",
    "# Convert datetime64 to decimal years for regression\n",
    "eke_datetime_num = datetime_array.astype('datetime64[M]').astype(float)  # months since epoch\n",
    "# or more interpretable: convert to decimal years\n",
    "eke_datetime_yr = np.array([\n",
    "    d.astype('datetime64[Y]').astype(int) + 1970 +\n",
    "    (d.astype('datetime64[M]').astype(int) % 12) / 12\n",
    "    for d in datetime_array\n",
    "])"
