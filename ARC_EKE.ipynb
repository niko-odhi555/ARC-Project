    "print(f\"Slope: {slope:.4e} m²/s² per year\")\n",
    "print(f\"Intercept: {intercept:.4e}\")\n",
    "print(f\"R-squared: {r_value**2:.4f}\")\n",
    "print(f\"P-value: {p_value:.4f}\")\n",
